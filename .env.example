# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TCL_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# The OpenAI-compatible server THIS app exposes
TCL_SERVER_HOST=127.0.0.1
TCL_SERVER_PORT=8648
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TCL_SERVER_API_KEY=
TCL_MODEL_ID=tesla-charge-ledger

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# The app works FULLY without a backend (rules engine); the LLM only explains
# the ledger in free-form words. Vehicle data is sent only to
# this backend — nowhere else. This app never commands a car.
TCL_AI_BASE_URL=http://localhost:11434/v1
TCL_AI_API_KEY=
TCL_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TCL_AI_MODE=auto
TCL_AI_TIMEOUT_SECONDS=20

TCL_EMBEDDING_DIM=384
TCL_TOKEN_FILE=~/.tcl/tokens.json
# 1 = preview actions instead of storing them
TCL_DRY_RUN=0

# Charging-cost rules — plain words, set by `tcledger setup`
# Home time-of-use table: name|start|end|price-per-kWh, separated by ';'
# (SCE TOU-D-PRIME-style default: cheap overnight, $0.55/kWh 4:00–9:00 PM)
TCL_TOU_RATES=off-peak|12:00 AM|4:00 PM|0.28;peak|4:00 PM|9:00 PM|0.55;off-peak|9:00 PM|12:00 AM|0.28
# Flat defaults for public charging (override per session later if you like)
TCL_SUPERCHARGER_RATE=0.45
TCL_PUBLIC_RATE=0.40
TCL_DATA_FILE=~/.tcl/ledger.jsonl
